// TiEL playground: Vorschau auf HA1 Arrays
//
// Diese Datei ist absichtlich eine Zukunftsvorschau.
// Im aktuellen Stand des Interpreters läuft sie noch nicht,
// weil Arrays erst in HA1 implementiert werden.
//
// Wofür sie gut ist:
// 1. Kleine, überschaubare Beispiele für die spätere Array-Syntax
// 2. Klarer Vergleich mit stage_01_arrays.tiel
// 3. Gute Checkliste dafür, was Scanner, Parser, Binder und Evaluator können müssen
//
// Beim Implementieren von HA1:
// - Scanner:   [ und ] als Tokens erkennen
// - Parser:    Array-Literale, Indexzugriff, Index-Zuweisung parsen
// - Binder:    alle neuen inneren Ausdrücke traversieren
// - Evaluator: Arrays erzeugen, lesen und schreiben

print("arrays preview:start");

// 1. Array-Literal und Lesen per Index
var numbers = [10, 20, 30];
print(numbers[0]);
print(numbers[1]);
print(numbers[2]);

// 2. Schreiben per Index
numbers[1] = 99;
print(numbers[1]);

// 3. Verschachtelte Arrays
var matrix = [
    [1, 2],
    [3, 4]
];
print(matrix[0][1]);
print(matrix[1][0]);

// 4. Referenzverhalten / Aliasing
var inner = [5, 6];
var outer = [inner, inner];
outer[0][0] = 55;
print(inner[0]);
print(outer[1][0]);

// 5. Arrays aus Funktionen zurückgeben
fun makePair(a, b) {
    return [a, b];
}
print(makePair(7, 8)[0]);
print(makePair(7, 8)[1]);

print("arrays preview:end");
